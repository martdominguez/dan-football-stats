meta {
  name: Create Match
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/live-engine/api/matches
  body: json
  auth: none
}

headers {
  content-type: application/json
  Accept: application/json
}

body:json {
  {
    "leagueId": 1,
    "leagueName": "University Premier League",
    "homeTeamId": 1,
    "homeTeamName": "Campus Jaguars",
    "awayTeamId": 4,
    "awayTeamName": "Engineering Sharks"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.matchId) {
    bru.setVar("matchId", res.body.matchId);
  }
}
