meta {
  name: Create Match
  type: http
  seq: 1
}

post {
  url: http://localhost:8082/api/matches
}

headers {
  content-type: application/json
  Accept: application/json
}

body {
  {
    "leagueId": "33333333-3333-3333-3333-333333333333",
    "leagueName": "University Premier League",
    "homeTeamId": "11111111-1111-1111-1111-111111111111",
    "homeTeamName": "Campus Jaguars",
    "awayTeamId": "22222222-2222-2222-2222-222222222222",
    "awayTeamName": "Engineering Sharks"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.matchId) {
    bru.setVar("matchId", res.body.matchId);
  }
}
